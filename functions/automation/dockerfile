FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install OS-level dependencies required for Playwright and general operation
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libxss1 \
    libasound2 \
    libgtk-3-0 \
    libxshmfence1 \
    libgbm1 \
    xvfb \
    unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the source code
COPY . .

# Install Playwright browsers (useful for automation bots)
RUN python install_dependencies.py

# Expose the Cloud Run port
EXPOSE 8080

# Add Cloud Run-compatible health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD curl -f http://localhost:8080/ || exit 1

# Start Flask app
CMD ["python", "main.py"]
